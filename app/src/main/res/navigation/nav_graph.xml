<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/nav_graph"
  app:startDestination="@id/game_fragment">

  <fragment
    android:id="@+id/game_fragment"
    android:name="edu.cnm.deepdive.codebreaker.app.controller.GameFragment"
    android:label="@string/app_name"
    tools:layout="@layout/fragment_game">

    <action
      android:id="@+id/show_settings"
      app:destination="@id/settings_fragment"/>

  </fragment>

  <fragment
    android:id="@+id/incomplete_games_fragment"
    android:name="edu.cnm.deepdive.codebreaker.app.controller.IncompleteGamesFragment"
    android:label="@string/incomplete_games_fragment_label"
    tools:layout="@layout/fragment_incomplete_games">

  </fragment>

  <fragment
    android:id="@+id/settings_fragment"
    android:label="@string/settings_fragment_label"
    android:name="edu.cnm.deepdive.codebreaker.app.controller.SettingsFragment"/>

</navigation>