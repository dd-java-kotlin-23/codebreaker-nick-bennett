<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/header"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="horizontal"
  android:background="?attr/selectableItemBackground"
  android:clickable="true"
  android:focusable="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/half_dynamic_spacing"
    android:background="@drawable/item_separator">

    <TextView
      android:id="@+id/updated"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="3"
      android:layout_margin="@dimen/half_static_spacing"
      tools:text="07/07/2026"
      style="@style/ItemColumn.Header"/>

    <TextView
      android:id="@+id/code_length"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="2"
      android:layout_margin="@dimen/half_static_spacing"
      tools:text="5"
      style="@style/ItemColumn"/>

    <TextView
      android:id="@+id/pool_size"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="2"
      android:layout_margin="@dimen/half_static_spacing"
      tools:text="6"
      style="@style/ItemColumn"/>

    <TextView
      android:id="@+id/guess_count"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="2"
      android:layout_margin="@dimen/half_static_spacing"
      tools:text="8"
      style="@style/ItemColumn"/>

    <TextView
      android:id="@+id/exact_matches"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="2"
      android:layout_margin="@dimen/half_static_spacing"
      tools:text="3"
      style="@style/ItemColumn"/>

    <TextView
      android:id="@+id/near_matches"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="2"
      android:layout_margin="@dimen/half_static_spacing"
      tools:text="1"
      style="@style/ItemColumn"/>

  </LinearLayout>

</LinearLayout>
